#!/usr/bin/env bash
#
# Runs the fast gate — formatting, clippy and the test suite — before anything leaves the
# machine. GitHub Actions runs the full `just ci` on every push, so the slower checks it
# adds (debug assertions, the wasm size gate, the C API) are still enforced, just not here.
#
# pre-push rather than pre-commit, deliberately: the suite builds two wasm components and
# runs optimised, which is too slow to sit between typing `git commit` and getting your
# prompt back. Committing stays fast; pushing is where the gate belongs.
#
# Install with `just hooks`. Bypass with `git push --no-verify` when you genuinely need to.
set -euo pipefail

if ! command -v just >/dev/null 2>&1; then
    echo "pre-push: just is not installed — skipping checks" >&2
    exit 0
fi

echo "pre-push: running just pre-push (the full gate runs in CI)"
just pre-push

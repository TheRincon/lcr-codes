# Build output.
/target
/dist

# The component artifacts are built by `just component`, not committed — they are
# reproducible from source and would otherwise be a 280 KB binary in every diff.
*.wasm
.DS_Store
*/.DS_Store
# Generated by `just web`: jco output and the sample capture.
/web/lcr
/web/frame.rgba

# Fuzzing: the corpus and artifacts are grown, not authored. `just fuzz` reseeds the
# corpus from the golden vectors; a crash worth keeping becomes a unit test, not a file.
/fuzz/corpus
/fuzz/artifacts
/fuzz/target
/fuzz/Cargo.lock
